<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Merged into src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Phase 4 test trigger: shows the "You're up early" prompt from adb, without wake detection.
             Guarded by DUMP, which adb's shell has and other apps can't get.
             adb shell am broadcast -a com.dawnly.app.debug.USER_AWAKE -p com.dawnly.app [-ez stale true] -->
        <receiver
            android:name=".notify.DebugAwakeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.dawnly.app.debug.USER_AWAKE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
