<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for AlarmClock.ACTION_DISMISS_ALARM and ACTION_SET_ALARM (setting an alarm in the
         Clock app from Today). A normal permission, granted at install. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Starts the watch window on time. "Alarms & reminders" in settings; off by default on Android 14+. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms are cleared on reboot, so the window has to be scheduled again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Steps signal: onboarding asks for it. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- "Apps opened" signal: Usage access, granted by the user in system settings. Read only during
         the watch window, and only which app came to the front. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Onboarding's "Background use" step: a one-tap system dialog instead of a hunt through
         battery settings. Dawnly's core job (watching before an alarm) breaks if the OS stops it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Opt-in auto-dismiss only: lets Dawnly open the Clock app from the background, which
         Android 10+ blocks otherwise. Asked when the user turns that switch on. Nothing is drawn. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Auto-dismiss without Display over other apps (Android locks that one for apps installed
         from a file): a full-screen notification opens the dismiss straight away with the phone
         locked, and asks for one tap while it's in use. Granted at install. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Reminders that ring like an alarm: they vibrate, and keep the phone awake while ringing. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ package visibility: lets us find and name the Clock app, and find the home
         screen apps so opening them doesn't count as opening an app. Launcher apps: after a
         dismiss, the user goes back to the app they were in (QuietDismiss). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DISMISS_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DawnlyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dawnly">

        <!-- adjustResize: the keyboard pushes the reminder editor up instead of covering it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs only during a short, user-chosen window before the user's next alarm, watching for signs they woke up early so it can offer to dismiss that alarm." />
        </service>

        <receiver
            android:name=".service.WatchAlarmReceiver"
            android:exported="false" />

        <!-- Only the system sends these, and it can reach a receiver that isn't exported. -->
        <receiver
            android:name=".service.SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The prompt's "Dismiss alarm" button opens this straight from the notification
             (not a trampoline). No UI: it checks the alarm, then forwards to the Clock app. -->
        <activity
            android:name=".notify.DismissAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The prompt's "Not yet" button. -->
        <receiver
            android:name=".notify.NotYetReceiver"
            android:exported="false" />

        <!-- The user's reminders on Today: each one's alarm when it's due. -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <!-- A reminder set to ring like an alarm: plays its sound until Stop or Snooze. -->
        <service
            android:name=".notify.ReminderRingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rings a reminder the user chose to ring like an alarm, playing its sound until the user stops or snoozes it, for at most five minutes." />
        </service>

        <!-- The ringing reminder's screen, shown over the lock screen. -->
        <activity
            android:name=".notify.ReminderRingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Dawnly" />

        <!-- Opt-in auto-dismiss: our own alarm, when the one-minute warning runs out. -->
        <receiver
            android:name=".notify.AutoDismissReceiver"
            android:exported="false" />

        <!-- Opt-in "Still up?" after an auto-dismiss: asks, then rings if nobody answers. -->
        <receiver
            android:name=".notify.StillUpReceiver"
            android:exported="false" />

        <activity
            android:name=".notify.StillUpActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Dawnly" />
    </application>

</manifest>
