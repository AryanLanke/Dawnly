<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for AlarmClock.ACTION_DISMISS_ALARM. A normal permission, granted at install. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Starts the watch window on time. "Alarms & reminders" in settings; off by default on Android 14+. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms are cleared on reboot, so the window has to be scheduled again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Steps signal (Phase 3). Declared early so onboarding (Phase 5) can request it. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- "Apps opened" signal: Usage access, granted by the user in system settings. Read only during
         the watch window, and only which app came to the front. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Onboarding's "Background use" step: a one-tap system dialog instead of a hunt through
         battery settings. Dawnly's core job (watching before an alarm) breaks if the OS stops it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Opt-in auto-dismiss only: lets Dawnly open the Clock app from the background, which
         Android 10+ blocks otherwise. Asked when the user turns that switch on. Nothing is drawn. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The small vibrations under the finger (holding a tab, sliding between choices). Driven
         directly so they work with the phone's "Touch feedback" off (the user's choice). A normal
         permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11+ package visibility: lets us find and name the Clock app, and find the home
         screen apps so opening them doesn't count as opening an app. Launcher apps: after a
         dismiss, the user goes back to the app they were in (QuietDismiss). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DISMISS_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DawnlyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dawnly">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs only during a short, user-chosen window before the user's next alarm, watching for signs they woke up early so it can offer to dismiss that alarm." />
        </service>

        <receiver
            android:name=".service.WatchAlarmReceiver"
            android:exported="false" />

        <!-- Only the system sends these, and it can reach a receiver that isn't exported. -->
        <receiver
            android:name=".service.SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Phase 4: the prompt's "Dismiss alarm" button opens this straight from the notification
             (not a trampoline). No UI: it checks the alarm, then forwards to the Clock app. -->
        <activity
            android:name=".notify.DismissAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Phase 4: the prompt's "Not yet" button. -->
        <receiver
            android:name=".notify.NotYetReceiver"
            android:exported="false" />

        <!-- Opt-in auto-dismiss: our own alarm, when the one-minute warning runs out. -->
        <receiver
            android:name=".notify.AutoDismissReceiver"
            android:exported="false" />
    </application>

</manifest>
