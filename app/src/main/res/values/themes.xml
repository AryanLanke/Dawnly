<resources>
    <!-- Window theme only; all real theming happens in Compose (ui/theme). The window background
         matches the sky (light) or the wall (dark), so there's no flash before the first frame. -->
    <style name="Theme.Dawnly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/wall</item>
    </style>

    <color name="wall">#D9E8FF</color>
</resources>
