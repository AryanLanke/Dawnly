    <!-- Restricted settings help (Android 13+, apps installed from a file) -->
    <string name="restricted_title">Android locked %1$s</string>
    <string name="restricted_body">If Android said \"Restricted setting\" or that access was denied, your phone isn\'t refusing Dawnly. Android does this for apps installed from a file instead of an app store, until you unlock them once. It takes ten seconds:</string>
    <string name="restricted_step_1">1. Tap Open App info below. (Or open Settings, tap Apps, then Dawnly. If you can\'t find it, tap See all apps first.)</string>
    <string name="restricted_step_2">2. Tap ⋮ (More) at the top right, then Allow restricted settings.</string>
    <string name="restricted_step_3">3. Follow the steps on screen, like confirming with your PIN or fingerprint.</string>
    <string name="restricted_step_4">4. Come back to Dawnly and tap Allow again.</string>
    <string name="restricted_open">Open App info</string>
