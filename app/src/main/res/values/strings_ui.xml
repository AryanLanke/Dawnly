    <string name="oem_xiaomi">Xiaomi battery settings</string>
    <string name="oem_oppo">OPPO and OnePlus battery settings</string>
    <string name="oem_oppo_hint">On OPPO, OnePlus and realme phones, also turn on Auto-launch, and in App info › Battery usage, allow background activity.</string>
    <string name="oem_samsung_hint">On Samsung phones, also add Dawnly to Never sleeping apps in Battery settings.</string>
    <string name="oem_xiaomi_hint">On Xiaomi phones, also turn on Autostart and set Battery saver to No restrictions.</string>

