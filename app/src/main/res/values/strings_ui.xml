    <!-- Permissions -->
    <string name="perm_notifications">Notifications</string>
    <string name="perm_exact_alarms">Alarms &amp; reminders</string>
    <string name="perm_activity">Physical activity</string>
    <string name="perm_usage">Usage access</string>
    <string name="perm_battery">Background use</string>
    <string name="perm_overlay">Display over other apps</string>
    <string name="perm_notifications_why">So we can ask before dismissing your alarm. We never dismiss it on our own.</string>
    <string name="perm_exact_alarms_why">Lets Dawnly start watching the moment your window opens. It never sets alarms of its own.</string>
    <string name="perm_activity_why">Used only during the watch window to count steps. Nothing leaves your phone.</string>
    <string name="perm_usage_why">Used only during the watch window to count apps you open, not what you do in them. Nothing leaves your phone.</string>
    <string name="perm_battery_why">So your phone doesn\'t stop Dawnly halfway through the window.</string>
